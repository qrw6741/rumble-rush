; Engine configuration file.
; Rumble Rush — original top-down 3v3 arena brawler.

config_version=5

[application]

config/name="Rumble Rush"
config/description="Fast top-down 3v3 arena brawler with five original brawlers."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.09, 0.07, 0.16, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/data/config.gd"
Save="*res://scripts/autoload/save_data.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Router="*res://scripts/autoload/router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.09, 0.07, 0.16, 1)
textures/canvas_textures/default_texture_filter=1
