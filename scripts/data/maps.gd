## Returns the full 33-row grid (Array of PackedStringArray rows as Arrays of chars).
static func build_grid(map_id: String) -> Array:
	if MAPS[map_id].get("kind", "") == "quad":
		return _build_quad(MAPS[map_id].rows)
	if MAPS[map_id].get("kind", "") == "full":
		var g: Array = []
		for row: String in MAPS[map_id].rows:
			var r: Array = []
			for ch in row:
				r.append(ch)
			g.append(r)
		return g
	var top: Array = MAPS[map_id].rows
	assert(top.size() == 17)
	var grid: Array = []
	for r in H:
		var row: Array = []
		row.resize(W)
		grid.append(row)
	for r in 17:
		var s: String = top[r]
		assert(s.length() == W, "Row %d of %s has %d chars" % [r, map_id, s.length()])
		for c in W:
			var ch := s[c]
			grid[r][c] = ch
			var mr := H - 1 - r
			var mc := W - 1 - c
			if r == 16 and mc < c:
				continue # centre row is written explicitly, keep left side as authored
			var mch := ch
			if ch == "R":
				mch = "A"
			grid[mr][mc] = mch
	# centre row: mirror left half onto right half for perfect symmetry
	for c in W:
		var mc := W - 1 - c
		if c < mc:
			grid[16][mc] = grid[16][c]
	return grid


## 4-way rotational symmetry: every player in a free-for-all gets an equal arena.
static func _build_quad(q: Array) -> Array:
	var qn: int = q.size()          # 18
	var n: int = qn * 2 - 1         # 35
	var grid: Array = []
	for r in n:
		var row: Array = []
		row.resize(n)
		for c in n:
			var rr := r
			var cc := c
			for _k in 4:
				if rr < qn and cc < qn:
					break
				var t := rr
				rr = cc
				cc = n - 1 - t
			var ch: String = q[rr][cc] if rr < qn and cc < qn else "."
			row[c] = ch
		grid.append(row)
	return grid
