class_name MapData
extends RefCounted
## Map layouts. Only the TOP half (rows 0-16) of each 21x33 map is written; the
## bottom half is generated by 180° point symmetry so both teams get a perfectly
## fair layout. Legend:
##   .  floor        #  wall (blocks movement + shots)
##   B  bush (hide)  C  crate (destructible cover)
##   W  water (blocks movement, NOT shots)
##   R  red spawn (mirrored into a blue spawn)   G  gem mine (centre row only)

const W := 21
const H := 33

const MAPS := {
	"crystal_canyon": {
		"name": "CRYSTAL CANYON",
		"theme": {
			"floor_a": Color("e8b878"), "floor_b": Color("deac6b"), "floor_edge": Color("c48e52"),
			"wall_top": Color("c9734a"), "wall_side": Color("8e4a30"), "wall_line": Color("e39468"),
			"bush": Color("4fae4a"), "bush_dark": Color("2f7a35"),
			"water": Color("3fb6d8"), "water_light": Color("8fe3f5"),
			"crate": Color("b9824e"), "crate_dark": Color("7a5030"),
			"bg": Color("6b3a2a"), "decal": Color("c99556"),
		},
		"rows": [
			"BBBB.............BBBB",
			"BB.....R..R..R.....BB",
			"B...................B",
			"....##.........##....",
			"....##..CCCCC..##....",
			".....................",
			"BB...WWW.....WWW...BB",
			"BB...WWW.....WWW...BB",
			"BB.........#.......BB",
			"...###.........###...",
			"...#.....BBB.....#...",
			"...#....BBBBB....#...",
			"........C...C........",
			"BBB..##.......##..BBB",
			"BBB..##.......##..BBB",
			"BB.................BB",
			"BB......C.G.C......BB",
		],
	},
	"neon_district": {
		"name": "NEON DISTRICT",
		"theme": {
			"floor_a": Color("3b3f63"), "floor_b": Color("363a5b"), "floor_edge": Color("2a2d48"),
			"wall_top": Color("5a4fcf"), "wall_side": Color("2e2774"), "wall_line": Color("ff4fd8"),
			"bush": Color("27c99a"), "bush_dark": Color("137a62"),
			"water": Color("ff4fd8"), "water_light": Color("ffb3f0"),
			"crate": Color("4f8cff"), "crate_dark": Color("27459a"),
			"bg": Color("15142a"), "decal": Color("4a4f7a"),
		},
		"rows": [
			"##.................##",
			"#.....R....R....R...#",
			".....................",
			"..BB...#######...BB..",
			"..BB.............BB..",
			"..BB..CC.....CC..BB..",
			".....................",
			"###...##.....##...###",
			"......##.BBB.##......",
			"......##.BBB.##......",
			"..C..........C.......",
			"BBBB....###....BBBB..",
			"BBBB...........BBBB..",
			"....##.......##......",
			"....##..CCC..##......",
			".....................",
			"#..BB...C.G.C...BB..#",
		],
	},
}

## Returns the full 33-row grid (Array of PackedStringArray rows as Arrays of chars).
static func build_grid(map_id: String) -> Array:
	var top: Array = MAPS[map_id].rows
	assert(top.size() == 17)
	var grid: Array = []
	for r in H:
		var row: Array = []
		row.resize(W)
		grid.append(row)
	for r in 17:
		var s: String = top[r]
		assert(s.length() == W, "Row %d of %s has %d chars" % [r, map_id, s.length()])
		for c in W:
			var ch := s[c]
			grid[r][c] = ch
			var mr := H - 1 - r
			var mc := W - 1 - c
			if r == 16 and mc < c:
				continue # centre row is written explicitly, keep left side as authored
			var mch := ch
			if ch == "R":
				mch = "A"
			grid[mr][mc] = mch
	# centre row: mirror left half onto right half for perfect symmetry
	for c in W:
		var mc := W - 1 - c
		if c < mc:
			grid[16][mc] = grid[16][c]
	return grid
